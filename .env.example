# Runtime environment: development | production | test
NODE_ENV=development

# Server listening host and port
HOST=0.0.0.0
PORT=4000

# Public client origin used for CORS and shareable private room invite links
# In production behind HTTPS reverse proxy, e.g.: https://monopoly.yourdomain.com
CLIENT_ORIGIN=http://localhost:5173

# Enable if behind Nginx/Caddy reverse proxy (1 = trust first proxy hop for accurate rate-limiting IP)
TRUST_PROXY=0

# Directory for atomic JSON room session snapshots (relative to server working dir or absolute path)
DATA_DIR=./data

# HTTP & Socket rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_HTTP_REQUESTS=120
SOCKET_MAX_EVENTS_PER_WINDOW=60
SOCKET_WINDOW_MS=10000

# Session & Room lifecycle timeouts (milliseconds)
LOBBY_DISCONNECT_TTL_MS=120000
HOST_MIGRATION_TTL_MS=90000
IDLE_LOBBY_TTL_MS=7200000
IDLE_GAME_TTL_MS=43200000
FINISHED_ROOM_TTL_MS=1800000

# Log level: debug | info | warn | error
LOG_LEVEL=info