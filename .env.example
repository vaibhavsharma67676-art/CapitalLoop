# Runtime environment: development | production | test
NODE_ENV=development

# Server listening host and port
HOST=0.0.0.0
PORT=4000

# Public client origin used for CORS, invite links, and OAuth redirects
# In production on Railway, e.g.: https://your-app.up.railway.app
CLIENT_ORIGIN=http://localhost:5173

# Enable behind Railway/Nginx/Caddy reverse proxy (1 = trust first proxy hop)
TRUST_PROXY=0

# Directory for atomic JSON room session snapshots (set Railway Volume mount to /app/data)
DATA_DIR=./data

# HTTP & Socket rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_HTTP_REQUESTS=120
SOCKET_MAX_EVENTS_PER_WINDOW=60
SOCKET_WINDOW_MS=10000

# Session & Room lifecycle timeouts (milliseconds)
LOBBY_DISCONNECT_TTL_MS=120000
HOST_MIGRATION_TTL_MS=90000
IDLE_LOBBY_TTL_MS=7200000
IDLE_GAME_TTL_MS=43200000
FINISHED_ROOM_TTL_MS=1800000

# Optional Public Quick Matchmaking (never exposes private rooms)
MATCHMAKING_ENABLED=true

# Optional Discord Integration (leave blank to disable — game works fully without Discord)
# Never commit real secrets or webhook URLs to GitHub
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=
DISCORD_INVITE_URL=
DISCORD_WEBHOOK_URL=
DISCORD_SESSION_SECRET=

# Log level: debug | info | warn | error
LOG_LEVEL=info
